# Copy to .env. Everything here is optional.

# The address clients will open. Leave empty to try Handoff on this computer only.
# Examples: http://192.168.1.20:8081 (same Wi-Fi) or the https address your tunnel gives you.
PUBLIC_BASE_URL=

# Ports. The owner dashboard stays on 127.0.0.1 only.
OWNER_PORT=8080
SHARE_PORT=8081

# Uploads have no fixed size limit. These protect the disk:
# Free space the server refuses to go below (bytes). Empty = the larger of 2 GiB or 5% of the disk.
MIN_FREE_BYTES=
# Optional hard cap per file (bytes). Empty = no cap.
MAX_UPLOAD_BYTES=
MAX_CONCURRENT_UPLOADS=2

# Set to true ONLY if the share port sits behind a reverse proxy or tunnel you control, so the
# real client address is read from X-Forwarded-For. Leave empty otherwise.
TRUST_PROXY_HEADERS=

# Extra hostnames allowed to reach the owner dashboard (comma separated). Normally empty.
OWNER_ALLOWED_HOSTS=
