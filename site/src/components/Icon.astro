interface Props { name: keyof typeof paths | string; size?: number; }
const { name, size = 20 } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class="icon"
  set:html={paths[name] ?? ''}
/>
